<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".CombatActivity">

    <!-- Bouton combattre -->

    <!-- Bouton retour -->
    <Button
            android:id="@+id/btnFight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.0" app:layout_constraintHorizontal_bias="0.499"
            android:layout_marginTop="31dp" app:layout_constraintTop_toBottomOf="@+id/frameLayoutJoueur"/>
    <Button
            android:id="@+id/Retour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retour"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="16dp"/>

    <!-- Joueur -->
    <FrameLayout
            android:id="@+id/frameLayoutJoueur"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- Image joueur -->
        <ImageView
                android:id="@+id/imageJoueur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/imgjoueur"
                android:scaleType="fitCenter"/>

    </FrameLayout>


    <LinearLayout
            android:id="@+id/layoutPlateau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <Button
            android:id="@+id/btnAtk1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/atk_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.578" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.851"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@+id/btnAtk2"/>
    <Button
            android:id="@+id/btnAtk2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/atk_2" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.778"
            app:layout_constraintVertical_bias="0.851" app:layout_constraintEnd_toStartOf="@+id/btnMove1"
            app:layout_constraintTop_toTopOf="parent"/>
    <Button
            android:id="@+id/btnMove1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/move" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.887" app:layout_constraintVertical_bias="0.851"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnMove2"/>
    <Button
            android:id="@+id/btnMove2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.871" app:layout_constraintVertical_bias="0.851"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>